import logging

logging.basicConfig(level=logging.INFO)

from JNAS_AI_CORE.orchestrator.orchestrator import AIOrchestrator
from JNAS_AI_CORE.orchestrator.registry_adapter import RegistryAdapter
from JNAS_AI_CORE.registry import ToolRegistry


def main():
    print("=" * 50)
    print("JNAS AI CORE v0.3 AUTONOMOUS")
    print("=" * 50)

    registry = ToolRegistry()

    registry_adapter = RegistryAdapter(
        registry
    )

    orchestrator = AIOrchestrator(
        registry_adapter=registry_adapter
    )
    orchestrator.initialize()

    while True:
        prompt = input("\nYou > ").strip()

        if prompt.lower() in ["exit", "quit"]:
            print("Bye...")
            break

        if not prompt:
            continue

        try:
            response = orchestrator.handle_request(prompt)

            print("\nJNAS >")
            print("Success:", response.success)
            print("Message:", response.message)

            if response.result:
                print("\nResult:")
                print(response.result)

            if response.errors:
                print("\nErrors:")
                for error in response.errors:
                    print("-", error)

        except Exception as e:
            print("\nERROR:", e)


if __name__ == "__main__":
    main()
