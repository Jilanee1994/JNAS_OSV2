from __future__ import annotations

from typing import Any
from pathlib import Path


class LLMPatchGenerator:
    """
    Adapter that exposes generate_patch()
    for SelfHealingEngine using existing LLMManager.
    """

    def __init__(self, llm_manager: Any):
        self.llm_manager = llm_manager

    def generate_patch(self, payload: dict[str, Any]) -> dict[str, str]:
        analysis = payload.get("analysis", {})

        feedback = payload.get("feedback", "")

        source_path = payload.get("source_path", "")

        if source_path and not str(source_path).endswith(".py"):
            module_name = str(source_path).rstrip("/").split("/")[-1]
            source_path = str(
                Path(source_path) / f"{module_name}.py"
            )

        prompt = f"""
You are a Python repair agent.

Repair this Python file:

Target:
{source_path}

Error:
{analysis}
        
        Previous repair feedback:
        {feedback}

        CRITICAL REPAIR RULE:
        Preserve every existing import name and public symbol exactly.
        If the error says:
        cannot import name 'X'
        then the repaired file MUST contain symbol X.
        Never rename X to another style.


Requirements:
- Modify ONLY the target file.
- Return the complete corrected content of that file.
- Do not generate __init__.py.
- Do not generate test files.
- Preserve existing class names, function names, and import names exactly.
- Never rename classes.
        Never import the target module itself.
        Never create inheritance wrappers to satisfy imports.
        Create the missing symbol directly in this file.

- Return only raw Python code.
- No markdown fences.
- No explanation.
"""

        response = self.llm_manager.generate(prompt)

        content = (
            response.content
            if hasattr(response, "content")
            else str(response)
        )

        # Remove markdown fences from LLM output
        if "```python" in content:
            content = content.replace("```python", "")

        if "```" in content:
            content = content.replace("```", "")

        content = content.strip()

        if not content.strip() or "{}" in content:
            return {
                "path": source_path,
                "content": "",
                "summary": "Empty repair generated",
            }

        return {
            "path": source_path,
            "content": content,
            "summary": "Generated full-file repair patch",
        }
