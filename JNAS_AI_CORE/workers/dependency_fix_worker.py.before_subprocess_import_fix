from __future__ import annotations

import logging
import re
from pathlib import Path
from typing import Any

from dataclasses import dataclass
from typing import Any


@dataclass
class WorkerResult:
    success: bool
    message: str
    result: Any = None
    errors: list[str] | None = None


class DependencyFixWorker:
    """
    Repairs missing Python dependencies.
    """

    name = "dependency_fix"
    task_type = "dependency_fix"

    def __init__(self):
        self.logger = logging.getLogger(
            "JNAS_AI_CORE.workers.dependency_fix"
        )

    def initialize(self):
        self.logger.info(
            "DependencyFixWorker initialized."
        )

    def validate(self) -> bool:
        return True

    def execute(
        self,
        task,
    ) -> WorkerResult:

        if isinstance(task, dict):
            error = "\n".join(
                [
                    str(task.get("analysis", "")),
                    str(task.get("traceback", "")),
                ]
            )
        else:
            error = str(task)

        match = re.search(
            r"No module named ['\"]([^'\"]+)['\"]",
            error,
        )

        if not match:
            return WorkerResult(
                success=False,
                message="Could not detect missing dependency.",
                result=None,
            )

        package = match.group(1)

        try:
            process = subprocess.run(
                [
                    sys.executable,
                    "-m",
                    "pip",
                    "install",
                    package,
                ],
                capture_output=True,
                text=True,
                timeout=300,
                check=False,
            )

            if process.returncode == 0:
                return WorkerResult(
                    success=True,
                    message=f"Dependency installed: {package}",
                    result={
                        "package": package,
                        "action": "installed",
                    },
                )

            return WorkerResult(
                success=False,
                message=f"Dependency install failed: {package}",
                result=process.stderr,
            )

        except Exception as exc:
            return WorkerResult(
                success=False,
                message=f"Dependency installation error: {exc}",
                result=None,
            )

    def shutdown(self):
        self.logger.info(
            "DependencyFixWorker shutdown."
        )
